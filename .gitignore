# Node dependencies
node_modules/
package-lock.json

# Environment variables & secrets
.env
.secrets.env
*.env
!*.env.example

# WhatsApp Baileys Auth & Sessions (NEVER COMMIT)
auth_info_baileys/
auth_info_monitor/
**/auth_info_baileys/
**/auth_info_monitor/
*.json.key

# Databases & Runtime Data
*.db
*.sqlite
*.sqlite3
jax-shared/data/
!jax-shared/data/
jax-shared/data/*
!jax-shared/data/.gitkeep
!jax-shared/data/inventory/
jax-shared/data/inventory/*
!jax-shared/data/inventory/.gitkeep
!jax-shared/data/logs/
jax-shared/data/logs/*
!jax-shared/data/logs/.gitkeep

# Python cache & build artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.venv/
venv/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Backups & Temporary files
*.bak
*.pre-*
*.tmp
*.swp
.DS_Store
