# ====================================================================
# JAX Dealership OS - Environment Configuration Template
# Copy this file to .env and fill in your details: cp .env.example .env
# ====================================================================

# --------------------------------------------------------------------
# 1. Salesperson Profile & Communication Policy
# --------------------------------------------------------------------
SALESPERSON_NAME=your_name_here
OWNER_PHONE_NUMBER=your_phone_number_here
# OWNER_LID is auto-detected and registered during pairing (or can be set manually):
OWNER_LID=
DEALERSHIP_NAME=your_dealership_name_here

# Sales Companion First: All customer chats remain on your sales phone.
# When RESTRICT_TO_OWNER=true, the AI Agent only responds to YOU and
# never sends unprompted auto-replies to customers.
RESTRICT_TO_OWNER=true

# --------------------------------------------------------------------
# 2. Dealership CRM Portal Credentials
# --------------------------------------------------------------------
CRM_LOGIN_URL=https://your-dealership-crm-portal.com
CRM_BASE_URL=
CRM_USERNAME=your_crm_username
CRM_PASSWORD=your_crm_password

# --------------------------------------------------------------------
# 3. WhatsApp Bridge & Monitor Configuration
# --------------------------------------------------------------------
API_PORT=9095
HEALTH_PORT=9090
SQLITE_DB_PATH=./jax-shared/data/prospects.db
AUTH_DIR=./jax-whatsapp-monitor/auth_info_monitor
AGENT_AUTH_DIR=./jax-whatsapp-agent/auth_info_baileys

# --------------------------------------------------------------------
# 4. AI & Antigravity Configuration
# --------------------------------------------------------------------
# Antigravity CLI authenticates interactively during onboarding.
# You can also supply an API key directly if running headless:
# GEMINI_API_KEY=your_gemini_api_key

# --------------------------------------------------------------------
# 5. Telegram Notification & Watchdog (Optional)
# --------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
OWNER_USER_ID=

