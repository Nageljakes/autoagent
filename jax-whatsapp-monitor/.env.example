# Port for the internal HTTP API (used by agents to query history & send messages)
API_PORT=9095

# SQLite database file path
SQLITE_DB_PATH=./data/prospects.db

# Authentication directory for the monitoring WhatsApp Baileys session
AUTH_DIR=./auth_info_monitor

# Optional: Set your phone number with country code (e.g. 27841234567) to use 8-digit Pairing Code instead of QR
PAIRING_PHONE_NUMBER=

# Logging level: 'info', 'debug', 'warn', 'error'
LOG_LEVEL=info

# Set to true if you do not want to index group messages
IGNORE_GROUPS=true
